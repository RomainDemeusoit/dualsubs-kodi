<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.dualsubs" name="DualSubs" version="0.1.14" provider-name="Romain">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>
  <extension point="xbmc.python.script" library="default.py" />
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Display a second text subtitle over Kodi playback</summary>
    <description lang="en_GB">Prototype: extracts two embedded text subtitle streams with FFmpeg; Kodi renders one and this add-on overlays the other.</description>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
    <platform>all</platform>
    <license>MIT</license>
  </extension>
</addon>
